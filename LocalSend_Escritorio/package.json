{
  "name": "localsend-desktop",
  "version": "1.0.0",
  "description": "Clon de LocalSend - App de escritorio",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:win": "electron-vite build && electron-builder --win",
    "build:linux": "electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "buffer": "^6.0.3",
    "electron-store": "^8.2.0",
    "lucide-react": "^0.460.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "electron-vite": "^2.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  },
  "build": {
    "appId": "com.gaby.localsend",
    "productName": "LocalSend",
    "directories": {
      "output": "binarios"
    },
    "files": [
      "out/**/*"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "LocalSend_Desktop_Setup.exe"
    },
    "linux": {
      "target": "AppImage",
      "artifactName": "LocalSend_Desktop_Setup.AppImage"
    }
  }
}
